# Local development defaults. Copy to .env (gitignored) — Vite loads it automatically.
VITE_API_BASE_URL="http://localhost:3000"

# Firebase Web SDK config (docs/10-OPEN-DECISIONS.md §M4) — from Firebase Console → Project
# Settings → General → Your apps → Web app → SDK setup and configuration. Not secret (these
# are embedded in the public JS bundle by design), but Google Sign-In stays disabled
# (apps/web/src/lib/firebase/client.ts) until all four are set.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Restricts the Google account picker to this Workspace domain (matches apps/api's
# ALLOWED_EMAIL_DOMAIN — this one only shapes the picker UX, the API still enforces it).
VITE_ALLOWED_EMAIL_DOMAIN="econz.net"
