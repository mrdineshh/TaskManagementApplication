# Local development defaults — matches docker-compose.yml. Copy to .env.
DATABASE_URL="postgresql://taskapp:taskapp@localhost:5432/taskapp_dev?schema=public"

PORT=3000
NODE_ENV=development

# --- Bootstrap secrets (deployment-only per 01-ARCHITECTURE.md §2.9a) ---
# In prod these come from GCP Secret Manager, injected as env vars at deploy time.
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_TTL="30d"

# Firebase / Google OAuth client secret — required only when AUTH_PROVIDER=google.
FIREBASE_PROJECT_ID=""
GOOGLE_OAUTH_CLIENT_ID=""

# Which AuthProvider implementations are enabled (03-RBAC-AUTH.md §1.2).
# "dev" is a mocked provider for local development without real GCP/Firebase access —
# NOT enabled in staging/prod. "google" is the real Firebase-backed provider.
AUTH_PROVIDERS="dev,google"

# Restricts Google Sign-In to this domain (03-RBAC-AUTH.md §1.1).
ALLOWED_EMAIL_DOMAIN="econz.net"

# --- Admin-UI-configurable settings live in the DB (IntegrationSetting table), NOT here. ---
# SMTP, Slack webhooks, etc. are configured at runtime via /api/v1/integration-settings.
# For local dev without KMS, encryption falls back to a local dev key — see src/common/crypto.
DEV_KMS_FALLBACK_KEY="dev-only-32-byte-fallback-key!!"
