// Prisma schema — v1 data model per docs/02-DATA-MODEL.md.
// v1.1/v1.2-only tables (SLAPolicy, TimeLog, ApprovalStep, TaskDependency,
// SavedReport, ReportSchedule) are intentionally NOT modeled yet; they are
// added when those phases are built, per the doc's own phasing guidance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization / operational config (02-DATA-MODEL.md §2.1, §2.1a)
// ---------------------------------------------------------------------------

model OrganizationSettings {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("UTC")
  logoUrl   String?  @map("logo_url")
  ssoConfig Json?    @map("sso_config")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
}

model IntegrationSetting {
  id               String   @id @default(uuid())
  key              String   @unique
  config           Json     @default("{}")
  encryptedConfig  Bytes?   @map("encrypted_config")
  updatedById      String?  @map("updated_by_id")
  updatedBy        User?    @relation(fields: [updatedById], references: [id])
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("integration_settings")
}

// ---------------------------------------------------------------------------
// Departments & Users (02-DATA-MODEL.md §2.2, §2.3)
// ---------------------------------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  primaryUsers        User[]                @relation("PrimaryDepartment")
  userDepartments      UserDepartment[]
  roles               Role[]
  tasks               Task[]
  workflows           WorkflowDefinition[]
  priorities          PriorityDefinition[]
  customFieldDefs     CustomFieldDefinition[]

  @@map("departments")
}

enum AuthProviderType {
  google
  sso
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  fullName             String            @map("full_name")
  avatarUrl            String?           @map("avatar_url")
  primaryDepartmentId  String            @map("primary_department_id")
  primaryDepartment    Department        @relation("PrimaryDepartment", fields: [primaryDepartmentId], references: [id])
  authProvider         AuthProviderType  @default(google) @map("auth_provider")
  /// Null until the user's first successful sign-in — Admins can invite/create a user record ahead of that.
  authProviderId       String?           @map("auth_provider_id")
  isActive             Boolean           @default(true) @map("is_active")
  lastLoginAt          DateTime?         @map("last_login_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  departments          UserDepartment[]
  roles                UserRole[]
  createdTasks         Task[]            @relation("TaskCreatedBy")
  assignedTasks        Task[]            @relation("TaskAssignee")
  comments             TaskComment[]
  attachments          TaskAttachment[]
  activityLogEntries   ActivityLogEntry[]
  notifications        Notification[]
  updatedIntegrations  IntegrationSetting[]

  @@unique([authProvider, authProviderId])
  @@map("users")
}

model UserDepartment {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("user_departments")
}

// ---------------------------------------------------------------------------
// RBAC (02-DATA-MODEL.md §2.4, full logic in 03-RBAC-AUTH.md)
// ---------------------------------------------------------------------------

model Role {
  id           String   @id @default(uuid())
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  departmentId String?  @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permissions  RolePermission[]
  userRoles    UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId             String   @map("role_id")
  role               Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Optional per-assignment scope override — narrows a department-scoped role to one department.
  departmentOverride String?  @map("department_override")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Workflow configuration (02-DATA-MODEL.md §2.5a) — admin-editable, not an enum
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id           String   @id @default(uuid())
  name         String
  departmentId String?  @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")

  statuses    WorkflowStatus[]
  transitions WorkflowTransition[]
  tasks       Task[]

  @@map("workflow_definitions")
}

enum WorkflowStatusCategory {
  todo
  in_progress
  done
  cancelled
}

model WorkflowStatus {
  id           String                 @id @default(uuid())
  workflowId   String                 @map("workflow_id")
  workflow     WorkflowDefinition     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  key          String
  label        String
  category     WorkflowStatusCategory
  displayOrder Int                    @default(0) @map("display_order")
  color        String?

  tasksAsCurrentStatus  Task[] @relation("TaskStatus")
  transitionsFrom       WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo         WorkflowTransition[] @relation("TransitionTo")

  @@unique([workflowId, key])
  @@map("workflow_statuses")
}

model WorkflowTransition {
  id                  String             @id @default(uuid())
  workflowId          String             @map("workflow_id")
  workflow            WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStatusId        String             @map("from_status_id")
  fromStatus          WorkflowStatus     @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatusId          String             @map("to_status_id")
  toStatus            WorkflowStatus     @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)
  requiredPermission  String?            @map("required_permission")
  requiresApproval    Boolean            @default(false) @map("requires_approval") // v1.1

  @@unique([workflowId, fromStatusId, toStatusId])
  @@map("workflow_transitions")
}

// ---------------------------------------------------------------------------
// Priority configuration (02-DATA-MODEL.md §2.5b) — admin-editable, not an enum
// ---------------------------------------------------------------------------

model PriorityDefinition {
  id           String  @id @default(uuid())
  departmentId String? @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  key          String
  label        String
  displayOrder Int     @default(0) @map("display_order")
  color        String?
  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")

  tasks Task[]

  @@unique([departmentId, key])
  @@map("priority_definitions")
}

// ---------------------------------------------------------------------------
// Custom fields (02-DATA-MODEL.md §4) — department extensibility mechanism
// ---------------------------------------------------------------------------

enum CustomFieldType {
  text
  number
  date
  boolean
  select
  multi_select
  user_reference
}

model CustomFieldDefinition {
  id           String          @id @default(uuid())
  departmentId String?         @map("department_id")
  department   Department?     @relation(fields: [departmentId], references: [id])
  key          String
  label        String
  fieldType    CustomFieldType @map("field_type")
  options      Json?
  isRequired   Boolean         @default(false) @map("is_required")
  displayOrder Int             @default(0) @map("display_order")
  isActive     Boolean         @default(true) @map("is_active")

  values TaskCustomFieldValue[]

  @@unique([departmentId, key])
  @@map("custom_field_definitions")
}

model TaskCustomFieldValue {
  id                 String                 @id @default(uuid())
  taskId             String                 @map("task_id")
  task               Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldDefinitionId  String                 @map("field_definition_id")
  fieldDefinition    CustomFieldDefinition  @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  value              Json

  @@unique([taskId, fieldDefinitionId])
  @@map("task_custom_field_values")
}

// ---------------------------------------------------------------------------
// Tasks (02-DATA-MODEL.md §2.5-2.8, §3, §6)
// ---------------------------------------------------------------------------

model Task {
  id               String              @id @default(uuid())
  title            String
  description      String?
  departmentId     String              @map("department_id")
  department       Department          @relation(fields: [departmentId], references: [id])
  workflowId       String              @map("workflow_id")
  workflow         WorkflowDefinition  @relation(fields: [workflowId], references: [id])
  statusId         String              @map("status_id")
  status           WorkflowStatus      @relation("TaskStatus", fields: [statusId], references: [id])
  priorityId       String              @map("priority_id")
  priority         PriorityDefinition  @relation(fields: [priorityId], references: [id])
  assigneeId       String?             @map("assignee_id")
  assignee         User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById      String              @map("created_by_id")
  createdBy        User                @relation("TaskCreatedBy", fields: [createdById], references: [id])
  parentTaskId     String?             @map("parent_task_id")
  parentTask       Task?               @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks         Task[]              @relation("Subtasks")
  dueDate          DateTime?           @map("due_date")
  startDate        DateTime?           @map("start_date")
  completedAt      DateTime?           @map("completed_at")
  isRecurring      Boolean             @default(false) @map("is_recurring") // v1.1
  recurrenceRule   String?             @map("recurrence_rule") // v1.1, iCal RRULE
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")

  comments        TaskComment[]
  attachments     TaskAttachment[]
  customFieldValues TaskCustomFieldValue[]
  activityLog     ActivityLogEntry[]

  @@index([departmentId])
  @@index([assigneeId])
  @@index([statusId])
  @@index([dueDate])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String    @map("author_id")
  author    User      @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("task_comments")
}

model TaskAttachment {
  id            String   @id @default(uuid())
  taskId        String   @map("task_id")
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById  String   @map("uploaded_by_id")
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  fileName      String   @map("file_name")
  storagePath   String   @map("storage_path")
  mimeType      String   @map("mime_type")
  sizeBytes     BigInt   @map("size_bytes")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("task_attachments")
}

model ActivityLogEntry {
  id        String   @id @default(uuid())
  taskId    String?  @map("task_id")
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id")
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("activity_log_entries")
}

// ---------------------------------------------------------------------------
// Notifications (02-DATA-MODEL.md §7)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  in_app
  email
  push
  slack
}

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json                @default("{}")
  channel   NotificationChannel
  isRead    Boolean             @default(false) @map("is_read")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}
